# Copy to .env and fill in yourself. Never paste these values into chat or commit them.

# Mode: dry-run | live   (live also requires LIVE=1)
MODE=dry-run
LIVE=0
DATA_DIR=data
LOG_LEVEL=info          # debug | info | warn | error

# Solana. Sign up at helius.dev (free plan), copy your API key, and paste it over
# PASTE_HELIUS_KEY_HERE on BOTH lines below. Change nothing else on those lines.
# (Any other Solana RPC provider works too: replace the whole address with theirs.)
RPC_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=PASTE_HELIUS_KEY_HERE
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=PASTE_HELIUS_KEY_HERE
GRPC_URL=
GRPC_TOKEN=
# Optional. Sends trades to Jito as well as your RPC, with the tip from guardrails.yaml. Leave empty for no tip.
# Regional addresses (ny, slc, frankfurt, amsterdam, london, dublin, singapore, tokyo) are at docs.jito.wtf.
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Absolute path to the burner wallet keypair file, kept OUTSIDE this repo
WALLET_KEYPAIR_PATH=
# Dry-run only, optional. A PUBLIC address that holds SOL, used as the trader in simulations
# before your own wallet is funded. Nothing is signed for it and nothing is sent.
SIM_PAYER_PUBKEY=

# X (Twitter)
X_BEARER_TOKEN=
# Dry-run only, optional. Your own X account for rehearsals, as handle:user_id
# (get the number with: node scripts/x-lookup-user.ts yourhandle). Must be empty for live mode.
TEST_X_ACCOUNTS=

# Kick (optional, free). Create an app at kick.com > Settings > Developer.
# In that app, set the webhook URL to <WEBHOOK_PUBLIC_URL>/webhooks/kick and switch webhooks on.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Twitch EventSub (optional, free). Create an app at dev.twitch.tv/console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Any random 10-100 character string you make up. Twitch signs its webhooks with it.
TWITCH_EVENTSUB_SECRET=

# Kick and Twitch deliver events to a public https address, so they only work on the server.
# WEBHOOK_PUBLIC_URL is that address (no path). A reverse proxy or tunnel must forward it to WEBHOOK_PORT.
WEBHOOK_PUBLIC_URL=
WEBHOOK_PORT=8787

# Optional. Only used to tell whether a 0x address is on Ethereum or Base, for the manual-buy alert.
# Leave empty to use free public endpoints.
ETH_RPC_URL=
BASE_RPC_URL=

# Telegram alerts + control (your own bot, not a watch source).
# Make a bot with @BotFather (/newbot) and paste its token over PASTE_TELEGRAM_BOT_TOKEN_HERE.
TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
# Send your bot "hi", then run: node scripts/telegram-chat-id.ts   and put the number here.
TELEGRAM_OWNER_CHAT_ID=
