# Copy to .env and fill in yourself. Never paste these values into chat or commit them.

# Mode: dry-run | live   (live also requires LIVE=1)
MODE=dry-run
LIVE=0

# Solana
RPC_HTTP_URL=
RPC_WS_URL=
GRPC_URL=
GRPC_TOKEN=
JITO_BLOCK_ENGINE_URL=
# Absolute path to the burner wallet keypair file, kept OUTSIDE this repo
WALLET_KEYPAIR_PATH=

# X (Twitter)
X_BEARER_TOKEN=

# Kick (optional)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Telegram alerts + control
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
