#!/usr/bin/env bash
# Blocks commits that would publish secrets. THIS REPO IS PUBLIC.
# Enable once per clone:  git config core.hooksPath scripts/git-hooks
set -u
fail=0

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

# 1. Files that must never be committed.
bad_paths=$(printf '%s\n' "$files" \
  | grep -E '(^|/)\.env($|\.)|(^|/)id\.json$|keypair[^/]*\.json$|^(wallets|secrets|data)/|\.(key|pem|sqlite)$' \
  | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$bad_paths" ]; then
  echo "pre-commit: BLOCKED. These files must never be committed (public repo):" >&2
  printf '%s\n' "$bad_paths" | sed 's/^/  /' >&2
  fail=1
fi

# 2. Secret-shaped strings in the lines being added.
#    X bearer token | Telegram bot token | RPC api-key (UUID) | GitHub token | 64-byte keypair JSON
patterns='AAAAAAAAAAAAAAAAAAAA[A-Za-z0-9%]{30,}|[0-9]{8,10}:[A-Za-z0-9_-]{35}|[?&]api[-_]?key=[0-9a-fA-F-]{32,}|gh[pousr]_[A-Za-z0-9]{36}|\[ *([0-9]{1,3} *, *){63}[0-9]{1,3} *\]'
#    Solana secret key in base58 (same shape as a tx signature, so tests/ and the lockfile are exempt)
base58_secret='[1-9A-HJ-NP-Za-km-z]{86,90}'

while IFS= read -r f; do
  [ -z "$f" ] && continue
  added=$(git diff --cached -U0 --no-color -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+ ' || true)
  [ -z "$added" ] && continue
  if printf '%s\n' "$added" | grep -qE "$patterns"; then
    echo "pre-commit: BLOCKED. $f looks like it contains a secret (X bearer token, Telegram bot token, RPC api-key, GitHub token or keypair bytes)." >&2
    fail=1
  fi
  case "$f" in
    test/*|package-lock.json) ;;
    *)
      if printf '%s\n' "$added" | grep -qE "$base58_secret"; then
        echo "pre-commit: BLOCKED. $f has an 86-90 char base58 string, the shape of a Solana secret key." >&2
        fail=1
      fi
      ;;
  esac
done <<EOF
$files
EOF

if [ "$fail" -ne 0 ]; then
  echo "Secrets go in .env (gitignored). Fix the content. Don't bypass with --no-verify." >&2
  exit 1
fi
exit 0
